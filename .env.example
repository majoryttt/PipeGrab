# Telegram Bot Token from @BotFather (Required)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Admin Telegram User ID (Optional)
# If set, enables /admin control panel (stats, server health) and restricts cookies upload to this user ID
ADMIN_ID=123456789

# Local Telegram Bot API Server URL (Optional)
# If specified (e.g. http://localhost:8081 or http://telegram-bot-api:8081 in docker),
# allows uploading files up to 2000 MB (2 GB).
# If left empty, official https://api.telegram.org is used (50 MB limit).
LOCAL_BOT_API_URL=

# Proxy for Telegram Bot API (Optional, e.g. http://proxy.example.com:8080 or socks5://127.0.0.1:1080)
# Useful if hosting in regions where api.telegram.org is filtered/blocked.
TELEGRAM_PROXY=

# Max allowed video file size to upload in megabytes
# Recommended: 50 if using official API, 2000 if using Local Bot API Server
MAX_FILE_SIZE_MB=50

# Max playlist items a user can download at once
MAX_PLAYLIST_ITEMS=20

# Max concurrent global downloads processed by the bot at the same time
MAX_CONCURRENT_DOWNLOADS=3

# Optional path to cookies.txt (Netscape format) for YouTube / Instagram
COOKIES_FILE=data/cookies/cookies.txt

# Directory for temporary files
DOWNLOADS_DIR=downloads

# Automatically delete the user's message with the link after successful download (Optional, default: true)
DELETE_SOURCE_MESSAGE=false

# Optional Dump / Storage Channel ID for Inline Mode (e.g. -1001234567890)
# Required for sending newly downloaded media directly inside any chat via inline mode (@bot_username <link>).
# Bot must be an administrator with "Post messages" permission in this channel.
# If left empty, inline mode operates in cache-only mode (instant for cached links, deep-link card for new links).
DUMP_CHANNEL_ID=

# Cache time for Telegram Inline Query results in seconds (default: 300)
INLINE_CACHE_TIME=300

